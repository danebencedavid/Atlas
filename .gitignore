__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Generated Atlas outputs. CI regenerates these for Pages.
data/raw/*
data/processed/*
reports/figures/*
site/*

!data/raw/.gitkeep
!data/processed/.gitkeep
!reports/figures/.gitkeep
!site/.gitkeep

# Versioned reports are intentionally committed by CI.
!reports/periods/
!reports/periods/**
!reports/weeks/
!reports/weeks/**
