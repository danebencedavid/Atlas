__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
dist/

# Generated Atlas outputs. CI regenerates these for Pages.
data/raw/*
data/processed/*
reports/figures/*
site/*
theory/

# Local style scratchpads.
style-lab.html
style-lab-report.html

!data/raw/.gitkeep
!data/processed/.gitkeep
!reports/figures/.gitkeep
!site/.gitkeep

# Versioned reports are intentionally committed by CI.
!reports/periods/
!reports/periods/**
!reports/daily/
!reports/daily/**
!reports/weeks/
!reports/weeks/**

# Local Claude Code permissions, specific to one machine.
.claude/settings.local.json

# Credentials. Never commit any of these; an accident here cannot be undone
# once pushed.
.env
.env.*
*.pem
.cdsapirc
*token*
