__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# Generated Atlas outputs. CI regenerates these for Pages.
data/raw/*
data/processed/*
reports/figures/*
site/*
theory/

# Local style scratchpads.
style-lab.html
style-lab-report.html

# The forecast archive is append-only and must survive between CI runs,
# so unlike the rest of data/ it is committed.
!data/forecast_archive/
!data/forecast_archive/**

# CAMS irradiance truth. Committed for the same reason: it costs 32 authenticated
# ADS job submissions to rebuild, and it is the only irradiance truth Atlas has.
# 2.8 MB of CC BY 4.0 CSV is a cheap price for reproducibility.
!data/raw/cams/
!data/raw/cams/**

!data/raw/.gitkeep
!data/processed/.gitkeep
!reports/figures/.gitkeep
!site/.gitkeep

# Versioned reports are intentionally committed by CI.
!reports/periods/
!reports/periods/**
!reports/daily/
!reports/daily/**
!reports/weeks/
!reports/weeks/**

# Local Claude Code permissions, specific to one machine.
.claude/settings.local.json

# Credentials. Never commit any of these; an accident here cannot be undone
# once pushed.
.env
.env.*
*.pem
.cdsapirc
*token*
